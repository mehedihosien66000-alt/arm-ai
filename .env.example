# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_BASE_URL: Public canonical URL used in password reset and transactional emails.
APP_BASE_URL="http://localhost:3000"

# FIREBASE_SERVICE_ACCOUNT_JSON: Full Firebase Admin service account JSON (raw or base64)
# Required for creating unverified accounts, verifying 6-digit OTPs, and marking emailVerified=true.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# RESEND_API_KEY: Resend API key for real 6-digit OTP verification and password reset emails.
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender email address in Resend (e.g. "ARM AI <no-reply@yourdomain.com>").
EMAIL_FROM=""

# OTP_HMAC_SECRET: Server-only cryptographic secret used to HMAC-SHA256 hash 6-digit OTP codes.
OTP_HMAC_SECRET=""
